# LLM API settings. Use any OpenAI-compatible chat/completions provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.example-llm-provider.com/v1
LLM_MODEL=

# Embedding API settings. This can be a different OpenAI-compatible provider.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.example-embedding-provider.com/v1/embeddings
EMBEDDING_MODEL=

# Shared runtime settings.
REQUEST_TIMEOUT_SECONDS=120
CHROMA_DIR=data/chroma
ALLOW_LLM_NUDGE_REWRITE=false
